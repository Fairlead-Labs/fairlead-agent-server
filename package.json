{
  "name": "fairlead-agent-server",
  "version": "0.0.0",
  "description": "A multi-team agent server: sessions with owners, short runs that park in Postgres, tools over MCP, each team's own model account.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./directory": "./src/directory/migrations.ts",
    "./server": "./src/server/server.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "pg": "^8.23.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
